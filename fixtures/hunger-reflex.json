{
  "id": "hunger-reflex",
  "name": "Hunger reflex",
  "description": "An idle Acacia should eat carried bread when hunger is low.",
  "version": 1,
  "seed": "0",
  "worldType": "flat",
  "difficulty": "peaceful",
  "controller": { "type": "idle" },
  "timeLimitMs": 120000,
  "startReadyTimeoutMs": 120000,
  "startWhen": { "foodAtMost": 10 },
