@@ -0,0 +1,51 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { z } from "zod";
+import { ActionRunner } from "../session/action-runner.js";
+import { botFixture, type FakeStack } from "../test-support/bot.js";
+import type { NavigationRuntime } from "../navigation/index.js";
+import { actionResultSchema, defineAction } from "./action.js";
+import { createEnsureItemsAction } from "./ensure-items.js";
+
+test("a survival interruption rechecks inventory before repeating the interrupted operation", async () => {
+  const items: FakeStack[] = [{ name: "oak_log", count: 1 }, { name: "cobblestone", count: 3 }];
+  const bot = botFixture({ items }, {
+    clearControlStates() {},
+    deactivateItem() {},
+    recipesAll: (id: number) => id === bot.registry.itemsByName.stone_pickaxe.id
+      ? [{ result: { id, count: 1 }, delta: [{ id: bot.registry.itemsByName.cobblestone.id, count: -3 }], requiresTable: true }]
+      : [],
+  });
+  let started!: () => void;
+  const ready = new Promise<void>((resolve) => { started = resolve; });
+  let craftCalls = 0;
+  const craft = defineAction({
+    name: "craft_item", description: "Craft during the test.", inputSchema: z.object({}),
+    resultSchema: actionResultSchema({}), formatResult: () => "",
+    parse: () => ({}), execution: { kind: "task" },
+    async execute(_request, { signal }) {
+      craftCalls += 1;
+      started();
+      await new Promise<void>((resolve) => signal!.addEventListener("abort", () => resolve(), { once: true }));
+      signal!.throwIfAborted();
+      return { status: "succeeded" };
+    },
+  });
+  const objective = createEnsureItemsAction(bot, { cancel() {} } as NavigationRuntime, {
+    craft, smelt: craft, equip: craft, collect: craft, hunt: craft,
+  });
+  const runner = new ActionRunner();
+  const pending = runner.run(objective, { items: [{ item_name: "stone_pickaxe" }] }, undefined, undefined, "objective-id");
+  await ready;
+  const claim = runner.claim("hostile_reflex", "Protect the bot", async () => {
+    // The picked-up tool makes the interrupted craft unnecessary.
+    items.push({ name: "stone_pickaxe", count: 1 });
+    return { value: null, continuation: { kind: "resume" as const } };
+  });
+  assert.equal(claim.kind, "claimed");
+  const output = await pending;
+  assert.equal(output.result.status, "succeeded");
+  assert.equal(output.request?.id, "objective-id");
+  assert.equal(craftCalls, 1);
+  assert.deepEqual(output.interruptions, ["Protect the bot"]);
+});
diff --git a/src/actions/ensure-items.ts b/src/actions/ensure-items.ts
new file mode 100644
index 0000000..ab57c2e
--- /dev/null
+++ b/src/actions/ensure-items.ts
@@ -0,0 +1,179 @@
+import type { Bot } from "mineflayer";
+import { prepareBotForMovement } from "../session/prepare-body.js";
+import type { NavigationRuntime } from "../navigation/index.js";
+import { planCraftingFromInventory } from "../utils/craft-plan.js";
+import { carriedCount } from "../world/inventory-count.js";
+import { defineAction, type Action, type ActionContext, type ActionResult } from "./action.js";
+import { expectedDropName } from "./collect-block/collection-facts.js";
+import { MAX_COLLECT_BLOCKS } from "./collect-block/contract.js";
+import { equipmentSlots } from "./equip/equip.js";
+import type { EquipmentDestination } from "./equip/contract.js";
+import { ENSURE_ITEMS, ENSURE_ITEMS_DESCRIPTION, ensureItemsCheckpointSchema, ensureItemsInputSchema,
+  ensureItemsResultSchema } from "./ensure-items-contract.js";
+import { fuelCapacity } from "./smelt-item/smelt-item.js";
+
+const maxSteps = 32;
+const maxDependencyDepth = 8;
+// This version's recipe registry describes crafting. Keep the supported furnace transformations explicit.
+const furnaceInputs: Readonly<Record<string, string>> = {
+  cooked_beef: "beef", cooked_porkchop: "porkchop", cooked_mutton: "mutton",
+  cooked_chicken: "chicken", cooked_rabbit: "rabbit", cooked_cod: "cod", cooked_salmon: "salmon",
+  baked_potato: "potato", iron_ingot: "raw_iron", gold_ingot: "raw_gold", copper_ingot: "raw_copper",
+  glass: "sand", smooth_stone: "stone", stone: "cobblestone",
+};
+type Child = { action: Action; input: Record<string, unknown>; item: string };
+type Choice = Child | { blocker: string };
+type Children = { collect: Action; hunt: Action; craft: Action; smelt: Action; equip: Action };
+
+function carriedFuel(bot: Bot, input: string, count: number): string | undefined {
+  return [...new Set(bot.inventory.items().map((item) => item.name))]
+    .filter((item) => fuelCapacity(item) > 0 &&
+      carriedCount(bot, item) - (item === input ? count : 0) >= Math.ceil(count / fuelCapacity(item)))
+    .sort((a, b) => {
+      // Save scarce fuels that are also progression resources.
+      const penalty = (name: string) => Number(["blaze_rod", "coal_block", "dried_kelp_block"].includes(name));
+      return penalty(a) - penalty(b) || Math.ceil(count / fuelCapacity(a)) - Math.ceil(count / fuelCapacity(b));
+    })[0];
+}
+
+function equipped(bot: Bot, slot: EquipmentDestination): string | null {
+  return equipmentSlots(bot)[slot === "off-hand" ? "offHand" : slot];
+}
+
+function chooseAcquisition(bot: Bot, children: Children, item: string, count: number, path: readonly string[] = []): Choice {
+  if (path.length === maxDependencyDepth || path.includes(item))
+    return { blocker: `No eligible acquisition path for ${item} from the current supplies.` };
+  const registered = bot.registry.itemsByName[item];
+  if (!registered) return { blocker: `Unknown item ${item}.` };
+  const nextPath = [...path, item];
+  const prerequisite = (name: string, deficit: number) => chooseAcquisition(bot, children, name, deficit, nextPath);
+
+  const canAcquire = (name: string) => Boolean(furnaceInputs[name]) ||
+    Object.values(bot.registry.blockLoot).some((entry) => entry.drops.some((drop) => drop.item === name)) ||
+    Object.values(bot.registry.entityLoot).some((entry) => entry.drops.some((drop) => drop.item === name));
+  const craft = planCraftingFromInventory(bot, [{ id: registered.id, name: item, count }], canAcquire);
+  if (craft.kind === "ready") return { action: children.craft, input: { items: [{ item_name: item, count }] }, item };
+  const furnaceInput = furnaceInputs[item];
+  if (furnaceInput) {
+    if (carriedCount(bot, furnaceInput) < count) return prerequisite(furnaceInput, count - carriedCount(bot, furnaceInput));
+    if (carriedCount(bot, "furnace") < 1) return prerequisite("furnace", 1);
+    const fuel = carriedFuel(bot, furnaceInput, count);
+    if (!fuel) return prerequisite("coal", Math.ceil(count / fuelCapacity("coal")) - carriedCount(bot, "coal"));
+    return { action: children.smelt, input: { temporary_workstation: true, item_name: furnaceInput, count, fuel_item_name: fuel }, item };
+  }
+
+  const candidates = Object.values(bot.registry.blockLoot).filter((entry) =>
+    entry.drops.some((drop) => drop.item === item) && expectedDropName(bot, entry.block) === item);
+  // Use the nearest loaded source. The collection executor still validates access, tools and pickups.
+  const source = candidates.length ? bot.findBlock({
+    matching: candidates.map((entry) => bot.registry.blocksByName[entry.block]?.id).filter((id) => id !== undefined),
+    maxDistance: 64,
+  }) : null;
+  if (source) return { action: children.collect, input: { block_name: source.name, count: Math.min(count, MAX_COLLECT_BLOCKS) }, item };
+
+  const mobs = new Set(Object.values(bot.registry.entityLoot).filter((entry) => entry.drops.some((drop) => drop.item === item))
+    .map((entry) => entry.entity));
+  const quarry = mobs.size ? bot.nearestEntity((entity) => entity.name !== undefined && mobs.has(entity.name) &&
+    entity.position.distanceTo(bot.entity.position) <= 32) : null;
+  if (quarry?.name) return { action: children.hunt, input: { mob_name: quarry.name, drop_name: item, count }, item };
+
+  if (craft.kind === "missing_materials") {
+    for (const material of craft.plan.missingMaterials) {
+      const choice = prerequisite(material.item, material.count);
+      if ("action" in choice) return choice;
+    }
+    return { blocker: `Missing ${craft.plan.missingMaterials.map((material) => `${material.count} ${material.item}`).join(", ")} for ${item}.` };
+  }
+  return { blocker: `No usable loaded source for ${item}.` };
+}
+
+export function createEnsureItemsAction(bot: Bot, navigation: NavigationRuntime, children: Children) {
+  return defineAction({
+    name: ENSURE_ITEMS, description: ENSURE_ITEMS_DESCRIPTION, inputSchema: ensureItemsInputSchema,
+    checkpointSchema: ensureItemsCheckpointSchema, resultSchema: ensureItemsResultSchema,
+    execution: { kind: "resumable_task", prepare: () => prepareBotForMovement(bot, navigation) },
+    annotations: { destructiveHint: true, openWorldHint: true },
+    parse: (input) => ensureItemsInputSchema.parse(input),
+    formatResult: (result) => [
+      ...result.items.map(({ item, present, requested, destination }) =>
+        `- ${item}: ${present}/${requested}${destination ? ` in ${destination}` : " carried"}`),
+      ...(result.status === "succeeded" ? [] : [`Blocker: ${result.error}`]),
+    ].join("\n"),
+    begin: ({ items }, lifetime, observe) => {
+      const steps: string[] = [];
+      let phase = "checking_inventory";
+      let child: { choice: Child; execute: (context: ActionContext) => Promise<ActionResult>; before: number; end: () => void } | undefined;
+      const targets = () => items.map(({ item_name: item, count = 1, destination }) => ({
+        item, requested: count, destination,
+        present: destination ? Number(equipped(bot, destination) === item) : carriedCount(bot, item),
+      }));
+      const receipt = () => {
+        const { x, y, z } = bot.entity.position;
+        return { items: targets(), steps: [...steps], position: { x, y, z, dimension: bot.game.dimension } };
+      };
+      const blocked = (error: string) => {
+        const evidence = receipt();
+        const status = evidence.items.some((target) => target.present > 0) ? "partial" as const : "failed" as const;
+        return { ...evidence, status, error };
+      };
+      observe(() => {
+        const current = targets();
+        return { baseline: null, checkpoint: { phase,
+          gained: current.reduce((sum, item) => sum + Math.min(item.requested, item.present), 0),
+          requested: current.reduce((sum, item) => sum + item.requested, 0) },
+          completion: { kind: "current", observed: current.every((item) => item.present >= item.requested),
+            owes: "Requested quantities and slots are observed." } };
+      });
+      return async ({ signal }) => {
+        while (steps.length < maxSteps) {
+          if (lifetime.aborted) return { ...receipt(), status: "cancelled", error: String(lifetime.reason) };
+          signal?.throwIfAborted();
+          const target = targets().find((item) => item.present < item.requested);
+          if (!target) return { ...receipt(), status: "succeeded" };
+
+          if (!child) {
+            const carried = carriedCount(bot, target.item);
+            const choice = target.destination && carried > 0 ? {
+              action: children.equip, input: { items: [{ item_name: target.item, destination: target.destination }] }, item: target.item,
+            } : chooseAcquisition(bot, children, target.item, target.requested - target.present);
+            if ("blocker" in choice) return blocked(choice.blocker);
+            const request = choice.action.parse(choice.input);
+            const childLifetime = new AbortController();
+            const childSignal = AbortSignal.any([lifetime, childLifetime.signal]);
+            const execute = choice.action.begin
+              ? choice.action.begin(request, childSignal, () => {})
+              : (ctx: ActionContext) => choice.action.execute!(request, ctx);
+            child = { choice, execute, before: carriedCount(bot, choice.item), end: () => childLifetime.abort() };
+          }
+          const running = child;
+          phase = running.choice.action.name;
+          let result: ActionResult;
+          try {
+            result = await running.execute({ signal });
+          } catch (error) {
+            if (!signal?.aborted) throw error;
+            result = { status: "cancelled", error: String(error) };
+          }
+          if (lifetime.aborted) return { ...receipt(), status: "cancelled", error: String(lifetime.reason) };
+          if (signal?.aborted) {
+            // A resumable child can finish its interrupted attempt or recover its drops.
+            if (!running.choice.action.begin) {
+              running.end();
+              child = undefined;
+            }
+            return blocked("A survival response interrupted the current step.");
+          }
+          running.end();
+          child = undefined;
+          steps.push(`${phase} ${running.choice.item}`);
+          if (result.status !== "succeeded") return blocked(result.error);
+          if (phase !== "equip" && carriedCount(bot, running.choice.item) <= running.before)
+            return blocked(`No gain of ${running.choice.item} was observed after ${phase}.`);
+        }
+        return targets().every((item) => item.present >= item.requested)
+          ? { ...receipt(), status: "succeeded" }
+          : blocked("The objective reached its child-action limit.");
+      };
+    },
+  });
+}
