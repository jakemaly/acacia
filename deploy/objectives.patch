@@ -0,0 +1,35 @@
+import { z } from "zod";
+import { actionResultSchema } from "./action.js";
+import { EQUIPMENT_DESTINATIONS } from "./equip/contract.js";
+import { registryNameSchema } from "./registry-name.js";
+
+export const ENSURE_ITEMS = "ensure_items";
+export const ENSURE_ITEMS_DESCRIPTION =
+  "Reach a carried item quantity or fill specific equipment slots. Uses carried stock first, then available recipes and loaded sources. The result reports each remaining deficit and any blocker.";
+
+export const ensureItemsInputSchema = z.strictObject({
+  items: z.array(z.strictObject({
+    item_name: registryNameSchema,
+    count: z.number().int().min(1).max(64).optional().describe("Minimum to carry. Defaults to one."),
+    destination: z.enum(EQUIPMENT_DESTINATIONS).optional().describe("Equip one in this slot."),
+  }).refine((item) => item.destination === undefined || (item.count ?? 1) === 1,
+    "An equipment target has a count of one.")).min(1).max(6).superRefine((items, ctx) => {
+      const targets = items.map((item) => item.destination ?? item.item_name);
+      if (new Set(targets).size !== targets.length) {
+        ctx.addIssue({ code: "custom", message: "List each equipment slot or carried item once." });
+      }
+    }),
+});
+
+const targetResult = z.strictObject({
+  item: registryNameSchema, requested: z.number().int(), present: z.number().int(),
+  destination: z.enum(EQUIPMENT_DESTINATIONS).optional(),
+});
+export const ensureItemsResultSchema = actionResultSchema({
+  items: z.array(targetResult),
+  steps: z.array(z.string()),
+  position: z.strictObject({ x: z.number(), y: z.number(), z: z.number(), dimension: z.string() }),
+});
+export const ensureItemsCheckpointSchema = z.strictObject({
+  phase: z.string(), gained: z.number().int(), requested: z.number().int(),
+});
