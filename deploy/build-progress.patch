+test("a route that ends inside the same enclosure stops the build with a safety reason", async () => {
+  const { bot, physics, put, placements } = structureWorld();
+  // The waypoint lies in a roofed passage whose only outlet is the cell being filled.
+  for (let x = -1; x <= 3; x += 1) {
+    for (let y = 64; y <= 66; y += 1) {
+      for (let z = -1; z <= 2; z += 1) {
+        const passage = y <= 65 && ((x >= 0 && x <= 2 && z === 0) || (x === 2 && z === 1));
+        const outlet = y === 64 && x === 0 && z >= 1;
+        if (!passage && !outlet) put(new Vec3(x, y, z), "stone");
+      }
+    }
+  }
+  const arrival = { x: 2, y: 64, z: 1 };
+  let routes = 0;
+  const result = await build(bot, {
+    ...physics,
+    cells: cells([[0, 64, 1]]),
+    removeWrongBlocks: false,
+    route: async ({ goal }) => {
+      assert.equal(++routes, 1, "the same escape waypoint must not be retried");
+      const resolved = goal.resolve(observation());
+      assert.equal(resolved.kind, "active");
+      assert.ok(resolved.isSatisfied({ feet: arrival, remainingScaffolds: 0, overlayId: "" }, goalTestWorld));
+      bot.entity.position = new Vec3(arrival.x + 0.5, arrival.y, arrival.z + 0.5);
+      return { status: "completed", elapsedMs: 0 };
+    },
+  });
+
+  assert.equal(routes, 1);
+  assert.equal(result.status, "stopped");
+  assert.match(result.reason ?? "", /escape waypoint/);
+  assert.deepEqual(kinds(result), ["would_enclose"]);
+  assert.deepEqual(placements, []);
+});
