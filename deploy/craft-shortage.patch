+function missingScore(state: PlanningState): readonly number[] {
+  let missingUnits = 0;
+  let unfamiliarUnits = 0;
+  for (const [id, count] of state.missing) {
+    missingUnits += count;
+    // For equally short recipes, prefer more of a material already used from the bot's inventory.
