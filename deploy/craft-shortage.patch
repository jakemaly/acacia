+test("a short wooden tools batch asks for another carried species of log", () => {
+  const { Recipe } = createRequire(import.meta.url)("prismarine-recipe")(registry) as {
+    Recipe: { find(id: number, metadata: number | null): ReturnType<typeof bot.recipesAll> };
+  };
+  const { bot } = craftingBot({ oak_log: 3 });
+  bot.recipesAll = (id, metadata, table) => Recipe.find(id, metadata).filter((recipe) => !recipe.requiresTable || table);
