+  const started = new Promise<void>((resolve) => { entered = resolve; });
+  const action = defineAction({
+    name: "collect", description: "Test partial collection", inputSchema: z.object({}),
+    resultSchema: actionResultSchema({ collected: z.number() }), formatResult: (result) => String(result.collected),
+    execution: { kind: "resumable_task" }, parse: () => ({}),
+    begin: () => async ({ signal }) => {
+      entered();
+      await new Promise<void>((resolve) => signal!.addEventListener("abort", () => resolve(), { once: true }));
+      return { status: "partial", error: "Interrupted during collection.", collected: 1 };
+    },
+  });
+  const accepted = service.submit(action, {}, { submission_id: "partial", execution_timeout_ms: 30 }, 1);
+  assert.equal(accepted.state, "accepted");
+  if (accepted.state !== "accepted") return;
+  await started;
+  let release!: () => void;
+  const safe = new Promise<void>((resolve) => { release = resolve; });
+  const claim = runner.claim("hostile", "Threat nearby", async (signal) => {
