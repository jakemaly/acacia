+  const next = f.service.submit(f.action, {}, { submission_id: "next" }, 3);
+  assert.equal(next.state, "accepted");
+  if (next.state !== "accepted") return;
+  await pause(40);
+  assert.equal((await f.service.wait(next.actionId, 0)).state, "pending");
