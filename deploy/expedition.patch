diff --git a/src/actions/nether-loadout.ts b/src/actions/nether-loadout.ts
new file mode 100644
index 0000000..a8f5ee1
--- /dev/null
+++ b/src/actions/nether-loadout.ts
@@ -0,0 +1,53 @@
+import type { Bot } from "mineflayer";
+import { carriedCount } from "../world/inventory-count.js";
+import { scaffoldBlockNames } from "../navigation/mineflayer/movement-policy.js";
+import { equipmentSlots } from "./equip/equip.js";
+import type { EquipmentDestination } from "./equip/contract.js";
+
+export interface LoadoutTarget {
+  readonly item_name: string;
+  readonly count?: number;
+  readonly destination?: EquipmentDestination;
+}
+
+// Count the shield in the off-hand separately from the carried spare.
+export const netherLoadoutTargets: readonly LoadoutTarget[] = [
+  { item_name: "diamond_helmet", destination: "head" },
+  { item_name: "diamond_chestplate", destination: "torso" },
+  { item_name: "diamond_leggings", destination: "legs" },
+  { item_name: "diamond_boots", destination: "feet" },
+  { item_name: "shield", destination: "off-hand" },
+  { item_name: "shield", count: 1 },
+  { item_name: "diamond_pickaxe", count: 2 },
+  { item_name: "diamond_sword", count: 1 },
+  { item_name: "bow", count: 1 },
+  { item_name: "arrow", count: 48 },
+  { item_name: "golden_apple", count: 2 },
+  { item_name: "cooked_beef", count: 32 },
+  { item_name: "golden_boots", count: 1 },
+  { item_name: "cobblestone", count: 64 },
+];
+
+export function loadoutItemLabel(name: string): string {
+  if (name === "cooked_beef") return "cooked food";
+  if (name === "cobblestone") return "scaffold blocks";
+  return name;
+}
+
+export const expeditionFood = ["cooked_beef", "cooked_porkchop", "cooked_chicken", "cooked_mutton", "cooked_rabbit", "baked_potato"];
+
+export function netherLoadout(bot: Bot) {
+  const worn = equipmentSlots(bot);
+  return netherLoadoutTargets.map(({ item_name: item, count: requested = 1, destination }) => ({
+    item,
+    requested,
+    destination,
+    present: destination
+      ? Number(worn[destination === "off-hand" ? "offHand" : destination] === item)
+      : item === "cooked_beef"
+        ? expeditionFood.reduce((total, name) => total + carriedCount(bot, name), 0)
+        : item === "cobblestone"
+          ? scaffoldBlockNames(bot).reduce((total, name) => total + carriedCount(bot, name), 0)
+          : carriedCount(bot, item),
+  }));
+}
