diff --git a/src/actions/inventory-room.ts b/src/actions/inventory-room.ts
new file mode 100644
index 0000000..3600b57
--- /dev/null
+++ b/src/actions/inventory-room.ts
@@ -0,0 +1,45 @@
+import type { Bot } from "mineflayer";
+import { isInFire, isInLava } from "../survival/perception/body.js";
+import { carriedCount } from "../world/inventory-count.js";
+import type { ActionContext } from "./action.js";
+import type { createDropItemAction } from "./drop-item/drop-item.js";
+import type { createUseContainerAction } from "./use-container/use-container.js";
+
+export type MakeInventoryRoom = (protectedNames: ReadonlySet<string>, context: ActionContext) => Promise<string | null>;
+
+const terrain = new Set(["dirt", "granite", "andesite", "diorite", "cobbled_deepslate", "netherrack", "cobblestone"]);
+const scaffoldReserve = 64;
+
+export function inventoryRoom(
+  bot: Bot,
+  container: ReturnType<typeof createUseContainerAction>,
+  drop: ReturnType<typeof createDropItemAction>,
+): MakeInventoryRoom {
+  return async (protectedNames, context) => {
+    context.signal?.throwIfAborted();
+    if (!bot.entity.onGround || isInLava(bot) || isInFire(bot) || bot.currentWindow) return null;
+    const free = bot.inventory.emptySlotCount();
+    const candidates = bot.inventory.items().filter(({ name }) => !protectedNames.has(name) && name !== bot.heldItem?.name);
+    const item = candidates.find(({ name }) => name === "rotten_flesh") ??
+      candidates.find(({ name, count }) => terrain.has(name) && carriedCount(bot, name) - count >= scaffoldReserve);
+    if (!item) return null;
+
+    // Never route to a distant chest while the parent is trying to finish local work.
+    const chest = bot.findBlock?.({
+      matching: [bot.registry.blocksByName.chest.id, bot.registry.blocksByName.trapped_chest.id],
+      maxDistance: 4,
+    });
+    if (chest) {
+      const { x, y, z } = chest.position;
+      const items = [{ item_name: item.name, count: item.count }];
+      await container.execute(container.parse({ operation: "deposit", x, y, z, items }), context);
+      if (bot.inventory.emptySlotCount() > free) return `Deposited ${item.name} at ${x}, ${y}, ${z}.`;
+    }
+
+    // The disposal primitive confirms the toss and shares its exclusion set with pickup.
+    const count = Math.min(item.count, carriedCount(bot, item.name));
+    if (!count) return null;
+    await drop.execute(drop.parse({ items: [{ item_name: item.name, count }], in_a_hole: true }), context);
+    return bot.inventory.emptySlotCount() > free ? `Discarded surplus ${item.name}.` : null;
+  };
+}
